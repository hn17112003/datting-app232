@{
    ViewData["Title"] = "Phân tích";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>📊 Phân tích chi tiết</h2>
                <a href="/Admin/Index" class="btn btn-outline-secondary">← Quay lại Dashboard</a>
            </div>
        </div>
    </div>
    
    <div id="alertContainer"></div>
    
    <!-- Match Rate Analysis -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📈 Tỷ lệ Match</h5>
                </div>
                <div class="card-body">
                    <div id="matchRateContainer">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">⚙️ Cài đặt</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="activeDays" class="form-label">Số ngày hoạt động</label>
                        <select class="form-select" id="activeDays" onchange="loadActiveUsers()">
                            <option value="7">7 ngày</option>
                            <option value="14">14 ngày</option>
                            <option value="30">30 ngày</option>
                            <option value="60">60 ngày</option>
                            <option value="90">90 ngày</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="activeUsersCount" class="form-label">Số lượng users</label>
                        <input type="number" class="form-control" id="activeUsersCount" value="50" min="1" max="200" onchange="loadActiveUsers()">
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Active Users -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">👥 Người dùng hoạt động</h5>
                    <button class="btn btn-sm btn-outline-primary" onclick="loadActiveUsers()">Làm mới</button>
                </div>
                <div class="card-body">
                    <div id="activeUsersContainer">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/apiService.js"></script>
    <script src="~/js/adminHelper.js"></script>
    <script>
        // Check admin access
        document.addEventListener('DOMContentLoaded', async function() {
            const hasAccess = await AdminHelper.checkAdminAccess();
            if (!hasAccess) return;
            
            loadMatchRate();
            loadActiveUsers();
        });
        
        // Load match rate
        async function loadMatchRate() {
            const container = document.getElementById('matchRateContainer');
            try {
                const data = await ApiService.getMatchRate();
                const rate = (data.matchRate * 100).toFixed(2);
                container.innerHTML = `
                    <div class="text-center">
                        <h1 class="display-4 text-primary">${rate}%</h1>
                        <p class="lead">Tỷ lệ Match</p>
                        <hr>
                        <div class="row">
                            <div class="col-6">
                                <h4>${data.totalLikes}</h4>
                                <small class="text-muted">Tổng Likes</small>
                            </div>
                            <div class="col-6">
                                <h4>${data.totalMatches}</h4>
                                <small class="text-muted">Tổng Matches</small>
                            </div>
                        </div>
                    </div>
                `;
            } catch (error) {
                container.innerHTML = `<div class="alert alert-danger">Lỗi: ${error.message}</div>`;
            }
        }
        
        // Load active users
        async function loadActiveUsers() {
            const container = document.getElementById('activeUsersContainer');
            const days = parseInt(document.getElementById('activeDays').value) || 7;
            const take = parseInt(document.getElementById('activeUsersCount').value) || 50;
            
            container.innerHTML = '<div class="text-center"><div class="spinner-border"></div></div>';
            
            try {
                const users = await ApiService.getActiveUsers(days, take);
                
                if (users.length === 0) {
                    container.innerHTML = '<div class="alert alert-info">Chưa có người dùng hoạt động trong khoảng thời gian này</div>';
                    return;
                }
                
                container.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Email</th>
                                    <th>Hoạt động lần cuối</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${users.map((user, index) => `
                                    <tr>
                                        <td>${index + 1}</td>
                                        <td>${user.email}</td>
                                        <td>${AdminHelper.formatDate(user.lastActive)}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">Hiển thị ${users.length} người dùng hoạt động trong ${days} ngày qua</small>
                    </div>
                `;
            } catch (error) {
                container.innerHTML = `<div class="alert alert-danger">Lỗi: ${error.message}</div>`;
            }
        }
        
        function showAlert(type, message) {
            const alertContainer = document.getElementById('alertContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            alertContainer.innerHTML = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }
    </script>
}

