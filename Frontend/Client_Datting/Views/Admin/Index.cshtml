<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - LoveConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-pink: #ff4b91;
            --secondary-pink: #ff8fab;
            --light-pink: #fff5f7;
            --dark-pink: #e83e8c;
            --gradient: linear-gradient(135deg, #ff4b91 0%, #ff8fab 100%);
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .admin-header {
            background: var(--gradient);
            color: white;
            padding: 1.5rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 2px 10px rgba(255, 75, 145, 0.2);
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 1.5rem;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            }

        .card-primary {
            border-left: 4px solid var(--primary-pink);
        }

        .card-success {
            border-left: 4px solid #28a745;
        }

        .card-info {
            border-left: 4px solid #17a2b8;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--primary-pink);
            margin-bottom: 0.5rem;
        }

        .btn-pink {
            background: var(--gradient);
            border: none;
            color: white;
            border-radius: 25px;
            padding: 0.5rem 1.5rem;
            transition: all 0.3s ease;
        }

            .btn-pink:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(255, 75, 145, 0.4);
                color: white;
            }

        .quick-action-btn {
            background: white;
            border: 2px solid var(--light-pink);
            color: var(--primary-pink);
            border-radius: 15px;
            padding: 1rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
            text-align: center;
            display: block;
            text-decoration: none;
            font-weight: 500;
        }

            .quick-action-btn:hover {
                background: var(--light-pink);
                border-color: var(--primary-pink);
                color: var(--primary-pink);
                transform: translateY(-2px);
                text-decoration: none;
            }

        .table-custom {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

            .table-custom thead {
                background: var(--gradient);
                color: white;
            }

        .match-rate-display {
            text-align: center;
            padding: 2rem;
        }

        .match-rate-number {
            font-size: 3rem;
            font-weight: bold;
            color: var(--primary-pink);
            margin-bottom: 1rem;
        }

        .spinner-pink {
            color: var(--primary-pink);
        }

        .alert-custom {
            border-radius: 15px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <!-- Simple Header -->
    <div class="admin-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="h3 mb-0"><i class="fas fa-heart me-2"></i>Bảng điều khiển Admin</h1>
                    <p class="mb-0 opacity-75">Quản lý hệ thống LoveConnect</p>
                </div>
                <div class="col-auto">
                    <a href="/Admin/Logout" class="btn btn-light btn-sm rounded-pill">
                        <i class="fas fa-sign-out-alt me-1"></i>Đăng xuất
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div id="alertContainer"></div>

        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="stat-card card-primary">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title text-muted mb-2">Tổng số người dùng</h6>
                                <div class="stat-number" id="totalUsers">-</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-users fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card card-success">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title text-muted mb-2">Tổng số Match</h6>
                                <div class="stat-number" id="totalMatches">-</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-heart fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card card-info">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title text-muted mb-2">Tổng số tin nhắn</h6>
                                <div class="stat-number" id="totalMessages">-</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-comments fa-2x text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Match Rate & Quick Actions -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="stat-card">
                    <div class="card-body">
                        <h5 class="card-title mb-4"><i class="fas fa-chart-line me-2 text-primary"></i>Tỷ lệ Match</h5>
                        <div id="matchRateContainer" class="match-rate-display">
                            <div class="spinner-border spinner-pink" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-card">
                    <div class="card-body">
                        <h5 class="card-title mb-4"><i class="fas fa-bolt me-2 text-warning"></i>Thao tác nhanh</h5>
                        <a href="/Admin/Users" class="quick-action-btn">
                            <i class="fas fa-users me-2"></i>Quản lý Users
                        </a>
                        <a href="/Admin/Interests" class="quick-action-btn">
                            <i class="fas fa-tags me-2"></i>Quản lý Sở thích
                        </a>
                        <a href="/Admin/Analytics" class="quick-action-btn">
                            <i class="fas fa-chart-bar me-2"></i>Phân tích chi tiết
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Users -->
        <div class="row">
            <div class="col-12">
                <div class="stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="card-title mb-0"><i class="fas fa-user-clock me-2 text-success"></i>Người dùng hoạt động gần đây (7 ngày)</h5>
                            <button class="btn btn-pink btn-sm" onclick="loadActiveUsers()">
                                <i class="fas fa-sync-alt me-1"></i>Làm mới
                            </button>
                        </div>
                        <div id="activeUsersContainer">
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-pink" role="status">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Simple Footer -->
    <footer class="mt-5 py-3 text-center text-muted">
        <div class="container">
            <p class="mb-0">&copy; 2025 LoveConnect - Admin Dashboard</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/apiService.js"></script>
    <script src="~/js/adminHelper.js"></script>
    <script>
        // Check admin access
        document.addEventListener('DOMContentLoaded', async function() {
            const hasAccess = await AdminHelper.checkAdminAccess();
            if (!hasAccess) return;

            loadStatistics();
            loadMatchRate();
            loadActiveUsers();
        });

        // Load statistics
        async function loadStatistics() {
            try {
                const stats = await ApiService.getStatistics();
                document.getElementById('totalUsers').textContent = stats.totalUsers || 0;
                document.getElementById('totalMatches').textContent = stats.totalMatches || 0;
                document.getElementById('totalMessages').textContent = stats.totalMessages || 0;
            } catch (error) {
                showAlert('error', 'Không thể tải thống kê: ' + error.message);
            }
        }

        // Load match rate
        async function loadMatchRate() {
            try {
                const data = await ApiService.getMatchRate();
                const rate = (data.matchRate * 100).toFixed(2);
                document.getElementById('matchRateContainer').innerHTML = `
                    <div class="match-rate-number">${rate}%</div>
                    <p class="text-muted mb-0">
                        <strong>${data.totalMatches}</strong> matches từ <strong>${data.totalLikes}</strong> likes
                    </p>
                `;
            } catch (error) {
                document.getElementById('matchRateContainer').innerHTML = `
                    <div class="alert alert-warning alert-custom">Không thể tải dữ liệu</div>
                `;
            }
        }

        // Load active users
        async function loadActiveUsers() {
            const container = document.getElementById('activeUsersContainer');
            container.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-pink"></div></div>';

            try {
                const users = await ApiService.getActiveUsers(7, 10);
                if (users.length === 0) {
                    container.innerHTML = '<p class="text-muted text-center py-4">Chưa có người dùng hoạt động</p>';
                    return;
                }

                container.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-hover table-custom">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-envelope me-1"></i>Email</th>
                                    <th><i class="fas fa-clock me-1"></i>Hoạt động lần cuối</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${users.map(user => `
                                    <tr>
                                        <td>${user.email}</td>
                                        <td>${AdminHelper.formatDate(user.lastActive)}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `;
            } catch (error) {
                container.innerHTML = `<div class="alert alert-danger alert-custom">Lỗi: ${error.message}</div>`;
            }
        }

        function showAlert(type, message) {
            const alertContainer = document.getElementById('alertContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            alertContainer.innerHTML = `
                <div class="alert ${alertClass} alert-custom alert-dismissible fade show" role="alert">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }
    </script>
</body>
</html>