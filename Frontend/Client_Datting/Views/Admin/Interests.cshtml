<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Sở thích - LoveConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-pink: #ff4b91;
            --secondary-pink: #ff8fab;
            --light-pink: #fff5f7;
            --dark-pink: #e83e8c;
            --gradient: linear-gradient(135deg, #ff4b91 0%, #ff8fab 100%);
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .admin-header {
            background: var(--gradient);
            color: white;
            padding: 1.5rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 2px 10px rgba(255, 75, 145, 0.2);
        }

        .card {
            background: white;
            border-radius: 15px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 1.5rem;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            }

        .card-header {
            background: var(--gradient);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            border: none;
            padding: 1rem 1.5rem;
        }

        .btn-pink {
            background: var(--gradient);
            border: none;
            color: white;
            border-radius: 25px;
            padding: 0.5rem 1.5rem;
            transition: all 0.3s ease;
        }

            .btn-pink:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(255, 75, 145, 0.4);
                color: white;
            }

        .btn-outline-pink {
            border: 2px solid var(--primary-pink);
            color: var(--primary-pink);
            border-radius: 25px;
            padding: 0.5rem 1.5rem;
            transition: all 0.3s ease;
            background: white;
        }

            .btn-outline-pink:hover {
                background: var(--primary-pink);
                color: white;
                transform: translateY(-2px);
            }

        .interest-card {
            background: white;
            border-radius: 12px;
            border: 2px solid var(--light-pink);
            padding: 1.5rem;
            transition: all 0.3s ease;
            height: 100%;
        }

            .interest-card:hover {
                border-color: var(--primary-pink);
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(255, 75, 145, 0.15);
            }

        .interest-name {
            color: var(--primary-pink);
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .interest-id {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .form-control {
            border-radius: 12px;
            border: 2px solid #e9ecef;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: var(--primary-pink);
                box-shadow: 0 0 0 0.2rem rgba(255, 75, 145, 0.25);
            }

        .spinner-pink {
            color: var(--primary-pink);
        }

        .alert-custom {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .total-count {
            background: var(--light-pink);
            color: var(--primary-pink);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            display: inline-block;
        }
    </style>
</head>
<body>
    <!-- Simple Header -->
    <div class="admin-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="h3 mb-0"><i class="fas fa-tags me-2"></i>Quản lý Sở thích</h1>
                    <p class="mb-0 opacity-75">Thêm và quản lý các sở thích của người dùng</p>
                </div>
                <div class="col-auto">
                    <a href="/Admin/Index" class="btn btn-light btn-sm rounded-pill">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div id="alertContainer"></div>

        <!-- Add New Interest -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Thêm sở thích mới</h5>
                    </div>
                    <div class="card-body">
                        <form id="addInterestForm">
                            <div class="input-group">
                                <input type="text" class="form-control" id="interestName" placeholder="Nhập tên sở thích..." required>
                                <button type="submit" class="btn btn-pink">
                                    <i class="fas fa-plus me-1"></i>Thêm
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interests List -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Danh sách sở thích</h5>
                        <button class="btn btn-outline-pink btn-sm" onclick="loadInterests()">
                            <i class="fas fa-sync-alt me-1"></i>Làm mới
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="interestsContainer">
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-pink" role="status">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Simple Footer -->
    <footer class="mt-5 py-3 text-center text-muted">
        <div class="container">
            <p class="mb-0">&copy; 2025 LoveConnect - Quản lý Sở thích</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/apiService.js"></script>
    <script src="~/js/adminHelper.js"></script>
    <script>
        // Check admin access
        document.addEventListener('DOMContentLoaded', async function() {
            const hasAccess = await AdminHelper.checkAdminAccess();
            if (!hasAccess) return;

            loadInterests();

            // Add interest form
            document.getElementById('addInterestForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const name = document.getElementById('interestName').value.trim();
                if (!name) return;

                await addInterest(name);
            });
        });

        // Load interests
        async function loadInterests() {
            const container = document.getElementById('interestsContainer');
            container.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-pink"></div></div>';

            try {
                const interests = await ApiService.getAllInterests();

                if (interests.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-5">
                            <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Chưa có sở thích nào</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="row">
                        ${interests.map(interest => `
                            <div class="col-xl-3 col-lg-4 col-md-6 mb-3">
                                <div class="interest-card">
                                    <div class="interest-name">
                                        <i class="fas fa-hashtag me-1"></i>${interest.name}
                                    </div>
                                    <div class="interest-id">ID: ${interest.id}</div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <div class="mt-4 text-center">
                        <span class="total-count">
                            <i class="fas fa-tags me-1"></i>Tổng số: ${interests.length} sở thích
                        </span>
                    </div>
                `;
            } catch (error) {
                container.innerHTML = `
                    <div class="alert alert-danger alert-custom text-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>Lỗi: ${error.message}
                    </div>
                `;
            }
        }

        // Add interest
        async function addInterest(name) {
            const submitBtn = document.querySelector('#addInterestForm button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang thêm...';

            try {
                const response = await ApiService.createInterest(name);
                showAlert('success', '<i class="fas fa-check-circle me-2"></i>Đã thêm sở thích thành công!');
                document.getElementById('interestName').value = '';
                loadInterests();
            } catch (error) {
                showAlert('error', '<i class="fas fa-exclamation-triangle me-2"></i>Lỗi: ' + error.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        function showAlert(type, message) {
            const alertContainer = document.getElementById('alertContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            alertContainer.innerHTML = `
                <div class="alert ${alertClass} alert-custom alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }
    </script>
</body>
</html>