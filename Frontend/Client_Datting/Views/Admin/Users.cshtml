<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Users - LoveConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-pink: #ff4b91;
            --secondary-pink: #ff8fab;
            --light-pink: #fff5f7;
            --dark-pink: #e83e8c;
            --gradient: linear-gradient(135deg, #ff4b91 0%, #ff8fab 100%);
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .admin-header {
            background: var(--gradient);
            color: white;
            padding: 1.5rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 2px 10px rgba(255, 75, 145, 0.2);
        }

        .card {
            background: white;
            border-radius: 15px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
        }

        .card-header {
            background: var(--gradient);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            border: none;
            padding: 1.2rem 1.5rem;
        }

        .btn-pink {
            background: var(--gradient);
            border: none;
            color: white;
            border-radius: 25px;
            padding: 0.5rem 1.5rem;
            transition: all 0.3s ease;
        }

            .btn-pink:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(255, 75, 145, 0.4);
                color: white;
            }

        .btn-outline-pink {
            border: 2px solid var(--primary-pink);
            color: var(--primary-pink);
            border-radius: 25px;
            padding: 0.5rem 1.5rem;
            transition: all 0.3s ease;
            background: white;
        }

            .btn-outline-pink:hover {
                background: var(--primary-pink);
                color: white;
                transform: translateY(-2px);
            }

        .form-control {
            border-radius: 12px;
            border: 2px solid #e9ecef;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: var(--primary-pink);
                box-shadow: 0 0 0 0.2rem rgba(255, 75, 145, 0.25);
            }

        .form-select {
            border-radius: 12px;
            border: 2px solid #e9ecef;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-select:focus {
                border-color: var(--primary-pink);
                box-shadow: 0 0 0 0.2rem rgba(255, 75, 145, 0.25);
            }

        .table-custom {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

            .table-custom thead {
                background: var(--gradient);
                color: white;
            }

            .table-custom th {
                border: none;
                padding: 1rem;
                font-weight: 600;
            }

            .table-custom td {
                border-color: #f8f9fa;
                padding: 1rem;
                vertical-align: middle;
            }

        .badge-active {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
        }

        .badge-inactive {
            background: linear-gradient(135deg, #dc3545, #e83e8c);
            color: white;
        }

        .badge-verified {
            background: linear-gradient(135deg, #17a2b8, #6f42c1);
            color: white;
        }

        .badge-unverified {
            background: linear-gradient(135deg, #6c757d, #868e96);
            color: white;
        }

        .spinner-pink {
            color: var(--primary-pink);
        }

        .alert-custom {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .pagination .page-link {
            color: var(--primary-pink);
            border: 1px solid #dee2e6;
            border-radius: 8px;
            margin: 0 3px;
        }

        .pagination .page-item.active .page-link {
            background: var(--gradient);
            border-color: var(--primary-pink);
        }

        .modal-header {
            background: var(--gradient);
            color: white;
            border-radius: 15px 15px 0 0;
        }

        .btn-danger {
            background: linear-gradient(135deg, #dc3545, #e83e8c);
            border: none;
            border-radius: 8px;
        }

        .btn-success {
            background: linear-gradient(135deg, #28a745, #20c997);
            border: none;
            border-radius: 8px;
        }

        .stats-count {
            background: var(--light-pink);
            color: var(--primary-pink);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            display: inline-block;
        }
    </style>
</head>
<body>
    <!-- Simple Header -->
    <div class="admin-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="h3 mb-0"><i class="fas fa-users me-2"></i>Quản lý Người dùng</h1>
                    <p class="mb-0 opacity-75">Quản lý và theo dõi người dùng hệ thống</p>
                </div>
                <div class="col-auto">
                    <a href="/Admin/Index" class="btn btn-light btn-sm rounded-pill">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div id="alertContainer"></div>

        <!-- Filters and Search -->
        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Tìm kiếm theo email...">
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <select class="form-select" id="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Hidden">Hidden</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <button class="btn btn-pink w-100" onclick="loadUsers()">
                    <i class="fas fa-sync-alt me-1"></i>Làm mới
                </button>
            </div>
        </div>

        <!-- Users Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Danh sách người dùng</h5>
                    </div>
                    <div class="card-body">
                        <div id="usersContainer">
                            <div class="text-center py-5">
                                <div class="spinner-border spinner-pink" role="status">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="row mt-3">
            <div class="col-12">
                <nav>
                    <ul class="pagination justify-content-center" id="pagination">
                        <!-- Pagination will be generated here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Ban User Modal -->
    <div class="modal fade" id="banUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-lock me-2"></i>Xác nhận khóa tài khoản</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn khóa tài khoản này?</p>
                    <p class="text-muted"><strong id="banUserEmail"></strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" id="confirmBanBtn">
                        <i class="fas fa-lock me-1"></i>Khóa tài khoản
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Unban User Modal -->
    <div class="modal fade" id="unbanUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-unlock me-2"></i>Xác nhận mở khóa tài khoản</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn mở khóa tài khoản này?</p>
                    <p class="text-muted"><strong id="unbanUserEmail"></strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-success" id="confirmUnbanBtn">
                        <i class="fas fa-unlock me-1"></i>Mở khóa tài khoản
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Simple Footer -->
    <footer class="mt-5 py-3 text-center text-muted">
        <div class="container">
            <p class="mb-0">&copy; 2025 LoveConnect - Quản lý Users</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/apiService.js"></script>
    <script src="~/js/adminHelper.js"></script>
    <script>
        let currentPage = 0;
        const pageSize = 50;
        let allUsers = [];
        let filteredUsers = [];
        let banUserId = null;
        let unbanUserId = null;

        // Check admin access
        document.addEventListener('DOMContentLoaded', async function() {
            const hasAccess = await AdminHelper.checkAdminAccess();
            if (!hasAccess) return;

            loadUsers();

            // Search input
            document.getElementById('searchInput').addEventListener('input', filterUsers);
            document.getElementById('statusFilter').addEventListener('change', filterUsers);

            // Ban user modal
            const banModal = new bootstrap.Modal(document.getElementById('banUserModal'));
            document.getElementById('confirmBanBtn').addEventListener('click', async function() {
                if (banUserId) {
                    await banUser(banUserId);
                    banModal.hide();
                }
            });

            // Unban user modal
            const unbanModal = new bootstrap.Modal(document.getElementById('unbanUserModal'));
            document.getElementById('confirmUnbanBtn').addEventListener('click', async function() {
                if (unbanUserId) {
                    await unbanUser(unbanUserId);
                    unbanModal.hide();
                }
            });
        });

        // Load users
        async function loadUsers() {
            const container = document.getElementById('usersContainer');
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border spinner-pink"></div></div>';

            try {
                allUsers = await ApiService.getAllUsers(0, 200);
                filteredUsers = allUsers;
                currentPage = 0;
                displayUsers();
            } catch (error) {
                container.innerHTML = `
                    <div class="alert alert-danger alert-custom text-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>Lỗi: ${error.message}
                    </div>
                `;
            }
        }

        // Filter users
        function filterUsers() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;

            filteredUsers = allUsers.filter(user => {
                const matchSearch = !search || user.email.toLowerCase().includes(search);
                const matchStatus = !status || user.status === status;
                return matchSearch && matchStatus;
            });

            currentPage = 0;
            displayUsers();
        }

        // Display users
        function displayUsers() {
            const container = document.getElementById('usersContainer');
            const start = currentPage * pageSize;
            const end = start + pageSize;
            const pageUsers = filteredUsers.slice(start, end);

            if (pageUsers.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không tìm thấy người dùng nào</p>
                    </div>
                `;
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            container.innerHTML = `
                <div class="table-responsive">
                    <table class="table table-hover table-custom">
                        <thead>
                            <tr>
                                <th><i class="fas fa-envelope me-1"></i>Email</th>
                                <th><i class="fas fa-circle me-1"></i>Trạng thái</th>
                                <th><i class="fas fa-check-circle me-1"></i>Xác thực</th>
                                <th><i class="fas fa-calendar-plus me-1"></i>Ngày tạo</th>
                                <th><i class="fas fa-clock me-1"></i>Hoạt động lần cuối</th>
                                <th><i class="fas fa-cog me-1"></i>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${pageUsers.map(user => `
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-circle me-2 text-muted"></i>
                                            ${user.email}
                                        </div>
                                    </td>
                                    <td><span class="badge badge-pill ${user.status === 'Active' ? 'badge-active' : 'badge-inactive'}">${user.status}</span></td>
                                    <td><span class="badge badge-pill ${user.isVerified ? 'badge-verified' : 'badge-unverified'}">${user.isVerified ? 'Đã xác thực' : 'Chưa xác thực'}</span></td>
                                    <td><small class="text-muted">${AdminHelper.formatDate(user.createdAt)}</small></td>
                                    <td><small class="text-muted">${AdminHelper.formatDate(user.lastActive)}</small></td>
                                    <td>
                                        ${user.status !== 'Inactive' ? `
                                            <button class="btn btn-sm btn-danger" onclick="showBanModal('${user.id}', '${user.email}')">
                                                <i class="fas fa-lock me-1"></i>Khóa
                                            </button>
                                        ` : `
                                            <button class="btn btn-sm btn-success" onclick="showUnbanModal('${user.id}', '${user.email}')">
                                                <i class="fas fa-unlock me-1"></i>Mở khóa
                                            </button>
                                        `}
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-center">
                    <span class="stats-count">
                        <i class="fas fa-users me-1"></i>
                        Hiển thị ${start + 1}-${Math.min(end, filteredUsers.length)} trong tổng số ${filteredUsers.length} người dùng
                    </span>
                </div>
            `;

            // Pagination
            const totalPages = Math.ceil(filteredUsers.length / pageSize);
            let paginationHTML = '';

            if (totalPages > 1) {
                paginationHTML += `
                    <li class="page-item ${currentPage === 0 ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                `;

                for (let i = 0; i < totalPages; i++) {
                    paginationHTML += `
                        <li class="page-item ${i === currentPage ? 'active' : ''}">
                            <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i + 1}</a>
                        </li>
                    `;
                }

                paginationHTML += `
                    <li class="page-item ${currentPage === totalPages - 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                `;
            }

            document.getElementById('pagination').innerHTML = paginationHTML;
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredUsers.length / pageSize);
            if (page >= 0 && page < totalPages) {
                currentPage = page;
                displayUsers();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function showBanModal(userId, email) {
            banUserId = userId;
            document.getElementById('banUserEmail').textContent = email;
            const modal = new bootstrap.Modal(document.getElementById('banUserModal'));
            modal.show();
        }

        function showUnbanModal(userId, email) {
            unbanUserId = userId;
            document.getElementById('unbanUserEmail').textContent = email;
            const modal = new bootstrap.Modal(document.getElementById('unbanUserModal'));
            modal.show();
        }

        async function banUser(userId) {
            try {
                const response = await ApiService.banUser(userId);
                showAlert('success', '<i class="fas fa-check-circle me-2"></i>Đã khóa tài khoản thành công');
                loadUsers();
            } catch (error) {
                showAlert('error', '<i class="fas fa-exclamation-triangle me-2"></i>Lỗi: ' + error.message);
            }
        }

        async function unbanUser(userId) {
            try {
                const response = await ApiService.unbanUser(userId);
                showAlert('success', '<i class="fas fa-check-circle me-2"></i>Đã mở khóa tài khoản thành công');
                loadUsers();
            } catch (error) {
                showAlert('error', '<i class="fas fa-exclamation-triangle me-2"></i>Lỗi: ' + error.message);
            }
        }

        function showAlert(type, message) {
            const alertContainer = document.getElementById('alertContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            alertContainer.innerHTML = `
                <div class="alert ${alertClass} alert-custom alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }
    </script>
</body>
</html>