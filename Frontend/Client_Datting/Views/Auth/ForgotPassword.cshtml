@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Quên mật khẩu</h2>
                    
                    <div id="alertContainer"></div>
                    
                    <form id="forgotPasswordForm">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                            <div class="form-text">Nhập email của bạn để nhận liên kết đặt lại mật khẩu</div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 mb-3">Gửi yêu cầu</button>
                        
                        <div class="text-center">
                            <a href="/Auth/Login" class="text-decoration-none">Quay lại đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/apiService.js"></script>
    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const email = document.getElementById('email').value;
            const submitBtn = this.querySelector('button[type="submit"]');
            const alertContainer = document.getElementById('alertContainer');
            
            // Disable button
            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang gửi...';
            alertContainer.innerHTML = '';
            
            try {
                const response = await ApiService.forgotPassword(email);
                
                // Show success message
                alertContainer.innerHTML = `
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        ${response.message || 'Yêu cầu đã được gửi. Vui lòng kiểm tra email của bạn.'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                
                submitBtn.disabled = false;
                submitBtn.textContent = 'Gửi yêu cầu';
                
            } catch (error) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        ${error.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                
                submitBtn.disabled = false;
                submitBtn.textContent = 'Gửi yêu cầu';
            }
        });
    </script>
}

