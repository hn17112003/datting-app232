@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow pink-card">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4 pink-title">Đăng ký tài khoản</h2>

                    <div id="alertContainer"></div>

                    <form id="registerForm">
                        <div class="mb-3">
                            <label for="email" class="form-label pink-label">Email</label>
                            <input type="email" class="form-control pink-input" id="email" name="email" required>
                            <div class="form-text pink-text">Vui lòng nhập email hợp lệ</div>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label pink-label">Mật khẩu</label>
                            <input type="password" class="form-control pink-input" id="password" name="password" required minlength="6">
                            <div class="form-text pink-text">Mật khẩu tối thiểu 6 ký tự</div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label pink-label">Xác nhận mật khẩu</label>
                            <input type="password" class="form-control pink-input" id="confirmPassword" name="confirmPassword" required>
                            <div class="form-text pink-text" id="passwordMatchText"></div>
                        </div>

                        <button type="submit" class="btn pink-btn w-100 mb-3">
                            <span class="btn-text">Đăng ký</span>
                            <span class="btn-loading d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                Đang đăng ký...
                            </span>
                        </button>

                        <div class="text-center">
                            <span class="pink-text">Đã có tài khoản? </span>
                            <a href="/Auth/Login" class="pink-link">Đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pink-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(135deg, #fff5f7 0%, #fce4ec 100%);
        box-shadow: 0 8px 32px rgba(236, 64, 122, 0.15);
        border: 1px solid rgba(236, 64, 122, 0.1);
        backdrop-filter: blur(10px);
    }

    .pink-title {
        color: #ec407a;
        font-weight: 600;
        font-size: 1.8rem;
        text-shadow: 0 2px 4px rgba(236, 64, 122, 0.1);
    }

    .pink-btn {
        background: linear-gradient(45deg, #ec407a, #ad1457);
        border: none;
        border-radius: 25px;
        padding: 12px 24px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .pink-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(236, 64, 122, 0.4);
            color: white;
        }

        .pink-btn:active {
            transform: translateY(0);
        }

        .pink-btn:disabled {
            background: linear-gradient(45deg, #f8bbd9, #f48fb1);
            transform: none;
            box-shadow: none;
        }

    .pink-input {
        border: 2px solid #f8bbd9;
        border-radius: 12px;
        padding: 12px 16px;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.9);
    }

        .pink-input:focus {
            border-color: #ec407a;
            box-shadow: 0 0 0 0.2rem rgba(236, 64, 122, 0.25);
            background: white;
            transform: scale(1.02);
        }

        .pink-input.invalid {
            border-color: #f44336;
            background: rgba(255, 235, 238, 0.5);
        }

        .pink-input.valid {
            border-color: #4caf50;
            background: rgba(232, 245, 233, 0.5);
        }

    .pink-label {
        color: #ad1457;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .pink-text {
        color: #ec407a;
        font-size: 0.875rem;
    }

    .pink-link {
        color: #ec407a;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.3s ease;
        position: relative;
    }

        .pink-link:hover {
            color: #ad1457;
        }

        .pink-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 0;
            background: linear-gradient(45deg, #ec407a, #ad1457);
            transition: width 0.3s ease;
        }

        .pink-link:hover::after {
            width: 100%;
        }

    body {
        background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 50%, #f48fb1 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .alert-success {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border: none;
        color: #2e7d32;
        border-radius: 12px;
        border-left: 4px solid #4caf50;
    }

    .alert-danger {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: none;
        color: #c62828;
        border-radius: 12px;
        border-left: 4px solid #f44336;
    }

    .btn-loading .spinner-border {
        color: #fff;
    }

    /* Animation for card entrance */
    .card {
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Floating animation */
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    .pink-card {
        animation: float 8s ease-in-out infinite;
    }

    /* Password strength indicator */
    .password-strength {
        height: 4px;
        border-radius: 2px;
        margin-top: 5px;
        transition: all 0.3s ease;
    }

    .strength-weak {
        background: #f44336;
        width: 33%;
    }

    .strength-medium {
        background: #ff9800;
        width: 66%;
    }

    .strength-strong {
        background: #4caf50;
        width: 100%;
    }

    /* Heart decoration */
    .pink-card::before {
        content: '💖';
        position: absolute;
        top: -15px;
        right: -15px;
        background: linear-gradient(45deg, #ec407a, #ad1457);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 4px 15px rgba(236, 64, 122, 0.4);
        z-index: 1;
    }

    /* Progress bar for password */
    .password-progress {
        height: 3px;
        background: #f8bbd9;
        border-radius: 2px;
        margin-top: 5px;
        overflow: hidden;
    }

    .password-progress-bar {
        height: 100%;
        border-radius: 2px;
        transition: all 0.3s ease;
    }
</style>

@section Scripts {
    <script src="~/js/apiService.js"></script>
    <script>
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const submitBtn = this.querySelector('button[type="submit"]');
            const btnText = submitBtn.querySelector('.btn-text');
            const btnLoading = submitBtn.querySelector('.btn-loading');
            const alertContainer = document.getElementById('alertContainer');

            // Validate password match
            if (password !== confirmPassword) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Lỗi!</strong> Mật khẩu xác nhận không khớp!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                // Add shake animation
                const card = document.querySelector('.pink-card');
                card.style.animation = 'shake 0.5s ease-in-out';
                setTimeout(() => {
                    card.style.animation = 'float 8s ease-in-out infinite';
                }, 500);
                return;
            }

            // Show loading state
            btnText.classList.add('d-none');
            btnLoading.classList.remove('d-none');
            submitBtn.disabled = true;
            alertContainer.innerHTML = '';

            try {
                const response = await ApiService.register(email, password);

                // Show success message
                alertContainer.innerHTML = `
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Thành công!</strong> ${response.message || 'Đăng ký thành công! Vui lòng kiểm tra email để lấy mã xác thực.'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                // Show verify email form
                if (response.email) {
                    setTimeout(() => {
                        window.location.href = `/Auth/VerifyEmail?email=${encodeURIComponent(response.email)}`;
                    }, 2000);
                }

            } catch (error) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Lỗi!</strong> ${error.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                // Add shake animation on error
                const card = document.querySelector('.pink-card');
                card.style.animation = 'shake 0.5s ease-in-out';
                setTimeout(() => {
                    card.style.animation = 'float 8s ease-in-out infinite';
                }, 500);

            } finally {
                // Reset button state
                btnText.classList.remove('d-none');
                btnLoading.classList.add('d-none');
                submitBtn.disabled = false;
            }
        });

        // Real-time password validation
        document.getElementById('confirmPassword').addEventListener('input', function() {
            const password = document.getElementById('password').value;
            const confirmPassword = this.value;
            const matchText = document.getElementById('passwordMatchText');

            if (confirmPassword === '') {
                matchText.textContent = '';
                this.classList.remove('valid', 'invalid');
            } else if (password === confirmPassword) {
                matchText.textContent = '✓ Mật khẩu khớp';
                matchText.style.color = '#4caf50';
                this.classList.add('valid');
                this.classList.remove('invalid');
            } else {
                matchText.textContent = '✗ Mật khẩu không khớp';
                matchText.style.color = '#f44336';
                this.classList.add('invalid');
                this.classList.remove('valid');
            }
        });

        // Password strength indicator
        document.getElementById('password').addEventListener('input', function() {
            const password = this.value;
            const matchText = document.getElementById('passwordMatchText');

            if (password.length === 0) {
                matchText.textContent = 'Mật khẩu tối thiểu 6 ký tự';
                matchText.style.color = '#ec407a';
            } else if (password.length < 6) {
                matchText.textContent = 'Mật khẩu quá ngắn';
                matchText.style.color = '#f44336';
            } else {
                matchText.textContent = 'Mật khẩu hợp lệ';
                matchText.style.color = '#4caf50';
            }
        });

        // Add shake animation
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes shake {
                0%, 100% { transform: translateX(0); }
                25% { transform: translateX(-5px); }
                75% { transform: translateX(5px); }
            }
        `;
        document.head.appendChild(style);

        // Add interactive effects
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('.pink-input');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                input.addEventListener('blur', function() {
                    this.parentElement.classList.remove('focused');
                });
            });
        });
    </script>
}