@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var encodedToken = Context.Request.Query["t"].ToString();
    var encodedEmail = Context.Request.Query["e"].ToString();

    string email = "";
    string token = "";

    if (!string.IsNullOrEmpty(encodedToken) && !string.IsNullOrEmpty(encodedEmail))
    {
        try
        {
            token = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(encodedToken));
            email = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(encodedEmail));
        }
        catch
        {
            // Invalid token/email encoding
        }
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow pink-card">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4 pink-title">Đặt lại mật khẩu</h2>

                    <div id="alertContainer"></div>

                    <form id="resetPasswordForm">
                        <input type="hidden" id="email" name="email" value="@email">
                        <input type="hidden" id="token" name="token" value="@token">

                        @if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(token))
                        {
                            <div class="alert alert-danger pink-alert-error">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Link đặt lại mật khẩu không hợp lệ hoặc đã hết hạn. Vui lòng yêu cầu lại.
                            </div>
                            <div class="text-center mt-4">
                                <a href="/Auth/ForgotPassword" class="btn pink-btn me-2">Yêu cầu lại</a>
                                <a href="/Auth/Login" class="btn pink-btn-outline">Quay lại đăng nhập</a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label for="emailDisplay" class="form-label pink-label">Email</label>
                                <input type="email" class="form-control pink-input" id="emailDisplay" value="@email" readonly>
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label pink-label">Mật khẩu mới</label>
                                <input type="password" class="form-control pink-input" id="newPassword" name="newPassword" required minlength="6">
                                <div class="form-text pink-text">Mật khẩu tối thiểu 6 ký tự</div>
                                <div class="password-progress mt-2">
                                    <div class="password-progress-bar" id="passwordStrengthBar"></div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label pink-label">Xác nhận mật khẩu mới</label>
                                <input type="password" class="form-control pink-input" id="confirmPassword" name="confirmPassword" required>
                                <div class="form-text pink-text" id="passwordMatchText"></div>
                            </div>

                            <button type="submit" class="btn pink-btn w-100 mb-3">
                                <span class="btn-text">Đặt lại mật khẩu</span>
                                <span class="btn-loading d-none">
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    Đang đặt lại...
                                </span>
                            </button>

                            <div class="text-center">
                                <a href="/Auth/Login" class="pink-link">Quay lại đăng nhập</a>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pink-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(135deg, #fff5f7 0%, #fce4ec 100%);
        box-shadow: 0 8px 32px rgba(236, 64, 122, 0.15);
        border: 1px solid rgba(236, 64, 122, 0.1);
        backdrop-filter: blur(10px);
    }

    .pink-title {
        color: #ec407a;
        font-weight: 600;
        font-size: 1.8rem;
        text-shadow: 0 2px 4px rgba(236, 64, 122, 0.1);
    }

    .pink-btn {
        background: linear-gradient(45deg, #ec407a, #ad1457);
        border: none;
        border-radius: 25px;
        padding: 12px 24px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .pink-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(236, 64, 122, 0.4);
            color: white;
        }

        .pink-btn:active {
            transform: translateY(0);
        }

        .pink-btn:disabled {
            background: linear-gradient(45deg, #f8bbd9, #f48fb1);
            transform: none;
            box-shadow: none;
        }

    .pink-btn-outline {
        background: transparent;
        border: 2px solid #ec407a;
        border-radius: 25px;
        padding: 10px 22px;
        font-weight: 600;
        color: #ec407a;
        transition: all 0.3s ease;
    }

        .pink-btn-outline:hover {
            background: #ec407a;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(236, 64, 122, 0.3);
        }

    .pink-input {
        border: 2px solid #f8bbd9;
        border-radius: 12px;
        padding: 12px 16px;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.9);
    }

        .pink-input:focus {
            border-color: #ec407a;
            box-shadow: 0 0 0 0.2rem rgba(236, 64, 122, 0.25);
            background: white;
            transform: scale(1.02);
        }

        .pink-input:read-only {
            background: rgba(248, 187, 217, 0.2);
            border-color: #f8bbd9;
        }

        .pink-input.invalid {
            border-color: #f44336;
            background: rgba(255, 235, 238, 0.5);
        }

        .pink-input.valid {
            border-color: #4caf50;
            background: rgba(232, 245, 233, 0.5);
        }

    .pink-label {
        color: #ad1457;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .pink-text {
        color: #ec407a;
        font-size: 0.875rem;
    }

    .pink-link {
        color: #ec407a;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.3s ease;
        position: relative;
    }

        .pink-link:hover {
            color: #ad1457;
        }

        .pink-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 0;
            background: linear-gradient(45deg, #ec407a, #ad1457);
            transition: width 0.3s ease;
        }

        .pink-link:hover::after {
            width: 100%;
        }

    body {
        background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 50%, #f48fb1 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .pink-alert-error {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: none;
        color: #c62828;
        border-radius: 12px;
        border-left: 4px solid #f44336;
    }

    .alert-success {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border: none;
        color: #2e7d32;
        border-radius: 12px;
        border-left: 4px solid #4caf50;
    }

    .alert-danger {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: none;
        color: #c62828;
        border-radius: 12px;
        border-left: 4px solid #f44336;
    }

    .btn-loading .spinner-border {
        color: #fff;
    }

    /* Animation for card entrance */
    .card {
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Floating animation */
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    .pink-card {
        animation: float 6s ease-in-out infinite;
    }

    /* Password strength indicator */
    .password-progress {
        height: 4px;
        background: #f8bbd9;
        border-radius: 2px;
        margin-top: 5px;
        overflow: hidden;
    }

    .password-progress-bar {
        height: 100%;
        border-radius: 2px;
        transition: all 0.3s ease;
        width: 0%;
    }

    .strength-weak {
        background: #f44336;
        width: 33%;
    }

    .strength-medium {
        background: #ff9800;
        width: 66%;
    }

    .strength-strong {
        background: #4caf50;
        width: 100%;
    }

    /* Key icon decoration */
    .pink-card::before {
        content: '🔑';
        position: absolute;
        top: -12px;
        right: -12px;
        background: linear-gradient(45deg, #ec407a, #ad1457);
        color: white;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        box-shadow: 0 4px 12px rgba(236, 64, 122, 0.3);
        z-index: 1;
    }

    /* Success checkmark */
    .success-check {
        color: #4caf50;
        font-size: 3rem;
        margin-bottom: 1rem;
    }
</style>

@section Scripts {
    <script src="~/js/apiService.js"></script>
    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const token = document.getElementById('token').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const submitBtn = this.querySelector('button[type="submit"]');
            const btnText = submitBtn.querySelector('.btn-text');
            const btnLoading = submitBtn.querySelector('.btn-loading');
            const alertContainer = document.getElementById('alertContainer');

            // Validate password match
            if (newPassword !== confirmPassword) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Lỗi!</strong> Mật khẩu xác nhận không khớp!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                // Add shake animation
                const card = document.querySelector('.pink-card');
                card.style.animation = 'shake 0.5s ease-in-out';
                setTimeout(() => {
                    card.style.animation = 'float 6s ease-in-out infinite';
                }, 500);
                return;
            }

            // Show loading state
            btnText.classList.add('d-none');
            btnLoading.classList.remove('d-none');
            submitBtn.disabled = true;
            alertContainer.innerHTML = '';

            try {
                const response = await ApiService.resetPassword(email, token, newPassword);

                // Show success message with checkmark
                alertContainer.innerHTML = `
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <div class="text-center">
                            <div class="success-check">✓</div>
                            <strong>Thành công!</strong> ${response.message || 'Đặt lại mật khẩu thành công!'}
                            <div class="mt-2">Đang chuyển hướng...</div>
                        </div>
                    </div>
                `;

                // Redirect to login
                setTimeout(() => {
                    window.location.href = '/Auth/Login';
                }, 2000);

            } catch (error) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Lỗi!</strong> ${error.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                // Add shake animation on error
                const card = document.querySelector('.pink-card');
                card.style.animation = 'shake 0.5s ease-in-out';
                setTimeout(() => {
                    card.style.animation = 'float 6s ease-in-out infinite';
                }, 500);

            } finally {
                // Reset button state
                btnText.classList.remove('d-none');
                btnLoading.classList.add('d-none');
                submitBtn.disabled = false;
            }
        });

        // Real-time password validation
        document.getElementById('confirmPassword').addEventListener('input', function() {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = this.value;
            const matchText = document.getElementById('passwordMatchText');

            if (confirmPassword === '') {
                matchText.textContent = '';
                this.classList.remove('valid', 'invalid');
            } else if (newPassword === confirmPassword) {
                matchText.textContent = '✓ Mật khẩu khớp';
                matchText.style.color = '#4caf50';
                this.classList.add('valid');
                this.classList.remove('invalid');
            } else {
                matchText.textContent = '✗ Mật khẩu không khớp';
                matchText.style.color = '#f44336';
                this.classList.add('invalid');
                this.classList.remove('valid');
            }
        });

        // Password strength indicator
        document.getElementById('newPassword').addEventListener('input', function() {
            const password = this.value;
            const strengthBar = document.getElementById('passwordStrengthBar');

            let strength = 0;
            if (password.length >= 6) strength += 1;
            if (password.length >= 8) strength += 1;
            if (/[A-Z]/.test(password)) strength += 1;
            if (/[0-9]/.test(password)) strength += 1;
            if (/[^A-Za-z0-9]/.test(password)) strength += 1;

            // Update strength bar
            strengthBar.className = 'password-progress-bar';
            if (password.length === 0) {
                strengthBar.style.width = '0%';
                strengthBar.style.backgroundColor = '#f8bbd9';
            } else if (strength <= 2) {
                strengthBar.classList.add('strength-weak');
            } else if (strength <= 4) {
                strengthBar.classList.add('strength-medium');
            } else {
                strengthBar.classList.add('strength-strong');
            }
        });

        // Add shake animation
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes shake {
                0%, 100% { transform: translateX(0); }
                25% { transform: translateX(-5px); }
                75% { transform: translateX(5px); }
            }
        `;
        document.head.appendChild(style);

        // Add interactive effects
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('.pink-input');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                input.addEventListener('blur', function() {
                    this.parentElement.classList.remove('focused');
                });
            });
        });
    </script>
}