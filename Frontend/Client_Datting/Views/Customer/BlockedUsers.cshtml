@{
    ViewData["Title"] = "Người dùng đã chặn";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="pink-title">🚫 Người dùng đã chặn</h2>
                <a href="/Profile/Index" class="btn pink-btn-outline">← Quay lại Hồ sơ</a>
            </div>
        </div>
    </div>

    <div id="alertContainer"></div>

    <!-- Blocked Users List -->
    <div class="row">
        <div class="col-12">
            <div class="card pink-card">
                <div class="card-header pink-card-header">
                    <h5 class="mb-0">Danh sách người đã chặn</h5>
                </div>
                <div class="card-body">
                    <div id="blockedUsersContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border pink-spinner" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pink-title {
        color: #ec407a;
        font-weight: 600;
        margin: 0;
    }

    .pink-card {
        border: none;
        border-radius: 15px;
        background: linear-gradient(135deg, #fff5f7 0%, #fce4ec 100%);
        box-shadow: 0 4px 20px rgba(236, 64, 122, 0.1);
        border: 1px solid rgba(236, 64, 122, 0.1);
    }

    .pink-card-header {
        background: linear-gradient(45deg, #ec407a, #ad1457);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        border: none;
        font-weight: 600;
    }

    .pink-btn-outline {
        background: transparent;
        border: 2px solid #ec407a;
        border-radius: 20px;
        padding: 8px 20px;
        font-weight: 500;
        color: #ec407a;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

        .pink-btn-outline:hover {
            background: #ec407a;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(236, 64, 122, 0.3);
        }

    .pink-btn {
        background: linear-gradient(45deg, #ec407a, #ad1457);
        border: none;
        border-radius: 15px;
        padding: 6px 16px;
        font-weight: 500;
        color: white;
        transition: all 0.3s ease;
        font-size: 0.875rem;
    }

        .pink-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(236, 64, 122, 0.4);
            color: white;
        }

    .pink-spinner {
        color: #ec407a;
        width: 2rem;
        height: 2rem;
    }

    .table {
        margin-bottom: 0;
    }

        .table th {
            background: rgba(236, 64, 122, 0.1);
            color: #ad1457;
            font-weight: 600;
            border-bottom: 2px solid #f8bbd9;
            padding: 12px 8px;
        }

        .table td {
            padding: 12px 8px;
            border-bottom: 1px solid #f8bbd9;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background: rgba(248, 187, 217, 0.1);
        }

    .alert-info {
        background: linear-gradient(135deg, #e3f2fd, #bbdefb);
        border: none;
        color: #1565c0;
        border-radius: 10px;
        border-left: 4px solid #2196f3;
    }

    .alert-success {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border: none;
        color: #2e7d32;
        border-radius: 10px;
        border-left: 4px solid #4caf50;
    }

    .alert-danger {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: none;
        color: #c62828;
        border-radius: 10px;
        border-left: 4px solid #f44336;
    }

    body {
        background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
        max-width: 1200px;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .d-flex {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .table-responsive {
            font-size: 0.875rem;
        }

        .pink-btn {
            padding: 4px 12px;
            font-size: 0.8rem;
        }
    }
</style>

@section Scripts {
    <script src="~/js/apiService.js"></script>
    <script>
        // Check authentication and role
        if (!ApiService.isAuthenticated()) {
            window.location.href = '/Auth/Login';
        }

        // Check if user is admin - redirect to admin panel
        (async function() {
            try {
                const user = await ApiService.getCurrentUser();
                const roleName = user.roleName || '';
                const isAdmin = roleName === 'Admin' || roleName === 'admin';
                if (isAdmin) {
                    alert('Admin không thể truy cập tính năng này. Vui lòng sử dụng Admin Panel.');
                    window.location.href = '/Admin/Index';
                }
            } catch (error) {
                console.error('Error checking role:', error);
            }
        })();

        // Load blocked users
        async function loadBlockedUsers() {
            const container = document.getElementById('blockedUsersContainer');

            try {
                const blockedUsers = await ApiService.getBlockedUsers();

                if (blockedUsers.length === 0) {
                    container.innerHTML = '<div class="alert alert-info">Bạn chưa chặn ai</div>';
                    return;
                }

                // Load profiles
                const usersWithProfiles = await Promise.all(blockedUsers.map(async (user) => {
                    let profile = null;
                    try {
                        profile = await ApiService.getProfileByUserId(user.id);
                    } catch (error) {
                        console.error('Error loading profile:', error);
                    }
                    return { ...user, profile };
                }));

                container.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tên</th>
                                    <th>Email</th>
                                    <th>Ngày chặn</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${usersWithProfiles.map(user => `
                                    <tr>
                                        <td>${user.profile?.knownAs || 'Chưa có tên'}</td>
                                        <td>${user.email}</td>
                                        <td>${formatDate(user.createdAt)}</td>
                                        <td>
                                            <button class="btn btn-sm btn-success" onclick="unblockUser('${user.id}', '${user.email}')">
                                                Bỏ chặn
                                            </button>
                                        </td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `;
            } catch (error) {
                container.innerHTML = `<div class="alert alert-danger">Lỗi: ${error.message}</div>`;
            }
        }

        async function unblockUser(userId, email) {
            if (!confirm(`Bạn có chắc muốn bỏ chặn ${email}?`)) return;

            try {
                await ApiService.unblockUser(userId);
                showAlert('success', 'Đã bỏ chặn người dùng!');
                loadBlockedUsers();
            } catch (error) {
                showAlert('error', 'Lỗi: ' + error.message);
            }
        }

        function formatDate(dateString) {
            if (!dateString) return 'N/A';
            const date = new Date(dateString);
            return date.toLocaleString('vi-VN');
        }

        function showAlert(type, message) {
            const alertContainer = document.getElementById('alertContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            alertContainer.innerHTML = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }

        // Load on page load
        loadBlockedUsers();
    </script>
}